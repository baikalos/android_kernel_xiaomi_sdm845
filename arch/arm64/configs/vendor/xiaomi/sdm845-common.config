# Platform
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_SDM845=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# DTBO
# CONFIG_BUILD_ARM64_DT_OVERLAY is not set

# exFAT
CONFIG_EXFAT_FS=y

# EROFS
CONFIG_EROFS_FS=y

# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_FINGERPRINT_SYNAPTICS4302=y

# Haptics
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_LEDS_QPNP_HAPTICS=y

# initramfs
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"
CONFIG_CMDLINE_EXTEND=y

# Speaker-ID
CONFIG_MFD_SPK_ID=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y

# Touchscreen
CONFIG_TOUCHSCREEN_COMMON=y

# Xiaomi - dipper-q-oss
CONFIG_CIFS=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_CODEPAGE_950=y
CONFIG_NLS_UTF8=y

# CC_WERROR
# CONFIG_CC_WERROR is not set

# TCP congestion control
CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
CONFIG_TCP_CONG_CUBIC=y
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Queueing discipline / AQM
CONFIG_NET_SCH_CODEL=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_DEFAULT_NET_SCH="fq_codel"

# I/O scheduler
#
# Grouped here because these come from three layers and cannot otherwise be
# read in one place: MQ_IOSCHED_DEADLINE and MQ_IOSCHED_KYBER are "default y"
# in block/Kconfig.iosched; IOSCHED_BFQ and BFQ_GROUP_IOSCHED are "default n"
# and are turned on by vendor/sdm845-perf_defconfig; DEFAULT_DEADLINE is here.
#
# Measured on the handset, not inferred, because reading the source alone gets
# this wrong three different ways:
#
#  - ufshcd sets host->use_blk_mq = false, overriding SCSI_MQ_DEFAULT and the
#    scsi_mod.use_blk_mq parameter. UFS runs the legacy elevator, so
#    mq-deadline, kyber and bfq are compiled in but unreachable on storage;
#    writing "kyber" to sda returns an error. Only loop devices are blk-mq.
#
#  - init.qcom.rc writes cfq back over sda and sdf at boot, so DEFAULT_IOSCHED
#    does not decide the scheduler for the partitions that matter. It does
#    decide it for sdb and sdd, which init leaves alone, and those come up on
#    deadline.
#
#  - That cfq is not the naive one. init.qcom.rc also sets slice_idle 0, which
#    removes the seek-oriented idling that makes cfq a poor fit for flash,
#    while group_idle stays at 8 so blkio.weight keeps working -- and it is in
#    use here, with the background cgroup held at 200 against 1000. deadline
#    has no notion of group weight, so switching storage to it would trade
#    working background-I/O throttling for nothing measurable.
#
# So this setting is deliberately left as a sane default for the queues init
# does not touch, and storage is deliberately left on Qualcomm's tuned cfq.
CONFIG_SCSI_MQ_DEFAULT=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_DEFAULT_DEADLINE=y
CONFIG_DEFAULT_IOSCHED="deadline"
